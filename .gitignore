# ── Audio & fixtures — must never enter git history (plan §12) ──────────
# Only the manifest (names + checksums) is tracked; audio lives outside the
# repo tree in $SWINGSCRIBE_FIXTURES.
tests/fixtures/*
!tests/fixtures/manifest.yaml
*.mp3
*.wav
*.flac
*.m4a

# Soundfonts — tens to hundreds of MB, fetched by scripts/setup_fixtures.py
# into $LOCALAPPDATA/swingscribe/fixtures (outside the tree), never committed.
# The glob is belt-and-braces for a copy that lands in the working directory.
*.sf2
*.sf3
*.dls
# MIDI: tier-1 renders write a scratch .mid on the way to fluidsynth, and
# anything derived from a commercial recording is as untrackable as the audio.
*.mid
*.midi

# Model weights & caches
*.ckpt
*.pt
*.pth
*.onnx
.swingscribe-cache/
.cache/
models/

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage

# Per-track GUI settings. They live beside the audio (deliberately — see
# docs/meter-plan.md), and they describe spans within commercial recordings,
# so they stay out of git like everything else derived from them (plan §12).
*.swingscribe.json

# Local listening-pass material — never tracked
mp3s/
benchmark/

# Cached benchmark transcriptions (scripts/score_benchmark.py). Note lists
# derived from commercial recordings — only aggregate metrics ship (plan §12).
.benchmark-notes.json
